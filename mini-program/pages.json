{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/message/message",
      "style": {
        "navigationBarTitleText": "消息"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "订单"
      }
    },
    {
      "path": "pages/my/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "subpkg",
      "pages": [
        {
          "path": "category/index",
          "style": {
            "navigationBarTitleText": "服务分类"
          }
        },
        {
          "path": "product/list",
          "style": {
            "navigationBarTitleText": "标准服务"
          }
        },
        {
          "path": "product/detail",
          "style": {
            "navigationBarTitleText": "服务详情"
          }
        },
        {
          "path": "order/create",
          "style": {
            "navigationBarTitleText": "提交需求"
          }
        },
        {
          "path": "order/create-custom",
          "style": {
            "navigationBarTitleText": "发布需求"
          }
        },
        {
          "path": "order/detail",
          "style": {
            "navigationBarTitleText": "订单详情"
          }
        },
        {
          "path": "order/pay",
          "style": {
            "navigationBarTitleText": "支付"
          }
        },
        {
          "path": "order/review",
          "style": {
            "navigationBarTitleText": "评价"
          }
        },
        {
          "path": "chat/room",
          "style": {
            "navigationBarTitleText": "报价商议"
          }
        },
        {
          "path": "my/join-us",
          "style": {
            "navigationBarTitleText": "加入我们"
          }
        },
        {
          "path": "my/refund-list",
          "style": {
            "navigationBarTitleText": "退款记录"
          }
        },
        {
          "path": "my/settings",
          "style": {
            "navigationBarTitleText": "设置"
          }
        },
        {
          "path": "my/about",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "subpkg"
      ]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#2979FF",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/icons/home.png",
        "selectedIconPath": "static/icons/home-active.png"
      },
      {
        "pagePath": "pages/message/message",
        "text": "消息",
        "iconPath": "static/icons/msg.png",
        "selectedIconPath": "static/icons/msg-active.png"
      },
      {
        "pagePath": "pages/order/list",
        "text": "订单",
        "iconPath": "static/icons/order.png",
        "selectedIconPath": "static/icons/order-active.png"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的",
        "iconPath": "static/icons/my.png",
        "selectedIconPath": "static/icons/my-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "定制接单",
    "navigationBarBackgroundColor": "#2979FF",
    "backgroundColor": "#F5F6FA",
    // #ifdef H5
    // 锁定桌面上 rpx 按 375 基准换算（当前框架默认值，显式声明防升级漂移，规划书 §3）
    // 注：本版本 uni-app（vue3）H5 运行时从 globalStyle 读取这两个键，manifest.json 的 h5 节点同步声明
    "rpxCalcMaxDeviceWidth": 960,
    "rpxCalcBaseDeviceWidth": 375
    // #endif
  },
  "topWindow": {
    "path": "windows/top-window.vue",
    "style": {
      "height": "60px"
    },
    "matchMedia": {
      "minWidth": 768
    }
  }
}
